@using SmartStudyPlanner.Web.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Smart Study Planner</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-split-body">

    <div class="auth-split">
        <!-- Left illustration panel -->
        <div class="auth-illustration">
            <div class="auth-illu-content">
                <div class="auth-illu-icon">
                    <i class="fas fa-book-open"></i>
                </div>
                <h2>Smart Study<br />Planner</h2>
                <p>Organize your studies, track your progress, and achieve your goals.</p>
                <div class="auth-illu-quote">
                    <i class="fas fa-check-circle"></i>
                    <span>Small steps, every day<br />lead to big results.</span>
                </div>
            </div>
        </div>

        <!-- Right form panel -->
        <div class="auth-form-panel">
            <div class="auth-form-wrapper">
                <h1 class="auth-title">Welcome Back</h1>
                <p class="auth-subtitle">Sign in to continue your learning journey.</p>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="form-group">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" type="password" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="auth-options">
                        <label class="auth-checkbox">
                            <input asp-for="RememberMe" /> Remember me
                        </label>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <button type="submit" class="btn-primary auth-btn">Login</button>
                </form>

                <p class="auth-footer">
                    Don't have an account? <a asp-controller="Account" asp-action="Register">Register</a>
                </p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
