@using SmartStudyPlanner.Domain.Entities
@using SmartStudyPlanner.Domain.Enums
@using SmartStudyPlanner.Application.DTOs
@using TaskStatus = SmartStudyPlanner.Domain.Enums.TaskStatus
@using Priority = SmartStudyPlanner.Domain.Enums.Priority
@model SmartStudyPlanner.Domain.Entities.Task

@{
    ViewData["Title"] = "Edit Task";
    var subjects = ViewBag.Subjects as List<SubjectDto> ?? new List<SubjectDto>();
}

<a asp-controller="Tasks" asp-action="Index" class="back-link">
    <i class="fas fa-arrow-left"></i> Back to Tasks
</a>

<div class="card form-card">
    <h1 class="page-title" style="margin-bottom:24px;">Edit Task</h1>

    <form asp-controller="Tasks" asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Title">Task Title <span class="required">*</span></label>
            <input asp-for="Title" type="text" placeholder="e.g. Finish C# LINQ exercises" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="SubjectId">Subject <span class="required">*</span></label>
            @if (subjects.Any())
            {
                <select asp-for="SubjectId">
                    <option value="">Select a subject</option>
                    @foreach (var subject in subjects)
                    {
                        <option value="@subject.Id">@subject.Name</option>
                    }
                </select>
            }
            else
            {
                <div style="background:#fff1e6; border:1px solid #fed7aa; border-radius:10px; padding:16px; text-align:center;">
                    <p style="margin:0 0 10px; color:var(--text-muted); font-size:14px;">
                        You don't have any subjects yet.
                    </p>
                    <a asp-controller="Subjects" asp-action="Create" class="btn-primary" style="padding:8px 16px; font-size:13px;">
                        <i class="fas fa-plus"></i> Add Subject
                    </a>
                </div>
            }
            <span asp-validation-for="SubjectId" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Priority">Priority <span class="required">*</span></label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()">
                </select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DueDate">Due Date <span class="required">*</span></label>
                <input asp-for="DueDate" type="date" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="EstimatedMinutes">Estimated Minutes</label>
                <input asp-for="EstimatedMinutes" type="number" min="0" />
                <span asp-validation-for="EstimatedMinutes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<TaskStatus>()">
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-controller="Tasks" asp-action="Index" class="btn-outline-soft">Cancel</a>
            <button type="submit" class="btn-primary">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
