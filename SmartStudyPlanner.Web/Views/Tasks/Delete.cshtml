@using SmartStudyPlanner.Domain.Enums
@model SmartStudyPlanner.Domain.Entities.Task

@{
    ViewData["Title"] = "Delete Task";
}

<a asp-controller="Tasks" asp-action="Index" class="back-link">
    <i class="fas fa-arrow-left"></i> Back to Tasks
</a>

<div class="card form-card" style="max-width:520px;">
    <h1 class="page-title" style="margin-bottom:8px;">Delete Task</h1>
    <p class="page-subtitle" style="margin-bottom:22px;">
        Are you sure you want to delete this task? This action cannot be undone.
    </p>

    <div class="detail-row">
        <span class="detail-label">Title</span>
        <span class="detail-value">@Model.Title</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Subject</span>
        <span class="detail-value">@(Model.Subject?.Name ?? "—")</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Priority</span>
        <span class="detail-value">@Model.Priority</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Due Date</span>
        <span class="detail-value">@Model.DueDate.ToString("MMM d, yyyy")</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Status</span>
        <span class="detail-value">@Model.Status</span>
    </div>

    <form asp-controller="Tasks" asp-action="Delete" method="post" style="margin-top:26px;">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-actions">
            <a asp-controller="Tasks" asp-action="Index" class="btn-outline-soft">Cancel</a>
            <button type="submit" class="btn-primary" style="background:#dc2626;">
                <i class="fas fa-trash"></i> Confirm Delete
            </button>
        </div>
    </form>
</div>
