```cshtml
@using SmartStudyPlanner.Application.DTOs
@model IEnumerable<SubjectDto>

<h2>Subjects</h2>

<a asp-controller="Subjects"
   asp-action="Create"
   class="btn btn-primary">
    + Add Subject
</a>

<hr />

@if (Model != null && Model.Any())
{
    @foreach (var subject in Model)
    {
        <div>
            <h3>@subject.Name</h3>
            <p>@subject.Description</p>
            <p>Difficulty: @subject.Difficulty</p>
            <p>Progress: @subject.Progress%</p>

            <a asp-controller="Subjects"
               asp-action="Details"
               asp-route-id="@subject.Id"
               class="btn btn-info">
                Details
            </a>

            <a asp-controller="Subjects"
               asp-action="Edit"
               asp-route-id="@subject.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-controller="Subjects"
               asp-action="Delete"
               asp-route-id="@subject.Id"
               class="btn btn-danger">
                Delete
            </a>
        </div>

        <hr />
    }
}
else
{
    <p>No subjects found.</p>
}
```