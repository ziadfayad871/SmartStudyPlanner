```cshtml
@using SmartStudyPlanner.Application.DTOs
@model SubjectDto

@{
    ViewData["Title"] = "Delete Subject";
}

<h2>Delete Subject</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this subject?
</div>

<div class="card mb-3">
    <div class="card-body">

        <h4>@Model.Name</h4>

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Difficulty:</strong>
            @Model.Difficulty
        </p>

        <p>
            <strong>Progress:</strong>
            @Model.Progress%
        </p>

        <p>
            <strong>Exam Date:</strong>
            @(Model.ExamDate?.ToString("yyyy-MM-dd") ?? "Not set")
        </p>

    </div>
</div>

<form asp-controller="Subjects" asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-controller="Subjects"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
```