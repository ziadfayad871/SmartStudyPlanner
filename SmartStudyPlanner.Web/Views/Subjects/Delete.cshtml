@using SmartStudyPlanner.Application.DTOs
@model SubjectDto

@{
    ViewData["Title"] = "Delete Subject";
}

<a asp-controller="Subjects" asp-action="Index" class="back-link">
    <i class="fas fa-arrow-left"></i> Back to Subjects
</a>

<div class="card form-card" style="max-width:520px;">
    <h1 class="page-title" style="margin-bottom:8px;">Delete Subject</h1>
    <p class="page-subtitle" style="margin-bottom:22px;">
        Are you sure you want to delete this subject? This action cannot be undone.
    </p>

    <div class="detail-row">
        <span class="detail-label">Name</span>
        <span class="detail-value">@Model.Name</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Difficulty</span>
        @{
            var diffColor = Model.Difficulty < 34 ? "#16a34a" : Model.Difficulty < 67 ? "#d97706" : "#dc2626";
        }
        <span class="detail-value" style="color:@diffColor;">@Model.Difficulty%</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Progress</span>
        <span class="detail-value">@Model.Progress%</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Exam Date</span>
        <span class="detail-value">@(Model.ExamDate?.ToString("MMM d, yyyy") ?? "Not set")</span>
    </div>

    <form asp-controller="Subjects" asp-action="Delete" method="post" style="margin-top:26px;">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <a asp-controller="Subjects" asp-action="Index" class="btn-outline-soft">Cancel</a>
            <button type="submit" class="btn-primary" style="background:#dc2626;">
                <i class="fas fa-trash"></i> Confirm Delete
            </button>
        </div>
    </form>
</div>
