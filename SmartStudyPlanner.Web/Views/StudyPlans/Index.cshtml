@model IEnumerable<SmartStudyPlanner.Domain.Entities.StudyPlan>

@{
    ViewData["Title"] = "Study Plans";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Study Plans</h1>
        <p class="page-subtitle">Group your sessions into focused plans.</p>
    </div>
    <a asp-action="Create" class="btn-primary">
        <i class="fas fa-plus"></i> New Plan
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div style="background:var(--hard-bg); color:var(--hard-text); padding:10px 16px; border-radius:10px; margin-bottom:18px; font-size:14px;">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

<div class="card form-card" style="margin-bottom:20px;">
    <h2 style="font-size:16px; font-weight:700; margin-bottom:4px;">
        <i class="fas fa-wand-magic-sparkles" style="color:var(--primary);"></i> Generate Plan Automatically
    </h2>
    <p style="color:var(--text-muted); font-size:13px; margin-bottom:16px;">Sessions are created from your weekly availability and exam priorities.</p>
    <form asp-action="Generate" method="post" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
        <div class="form-group" style="flex:2; min-width:180px; margin:0;">
            <label for="planName">Plan Name</label>
            <input type="text" name="planName" id="planName" placeholder="e.g. Midterm Revision" required />
        </div>
        <div class="form-group" style="flex:1; min-width:140px; margin:0;">
            <label for="startDate">From</label>
            <input type="date" name="startDate" id="startDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="form-group" style="flex:1; min-width:140px; margin:0;">
            <label for="endDate">To</label>
            <input type="date" name="endDate" id="endDate" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
        </div>
        <button type="submit" class="btn-primary">Generate</button>
    </form>
</div>

<div class="card">
    <table class="subjects-table">
        <thead>
            <tr>
                <th>Plan</th>
                <th>Period</th>
                <th>Sessions</th>
                <th>Created</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div style="font-weight:600;">@p.Name</div>
                            @if (!string.IsNullOrWhiteSpace(p.Description) && p.Description != "A study plan for a user.")
                            {
                                <div style="font-size:12.5px; color:var(--text-muted);">@p.Description</div>
                            }
                        </td>
                        <td>@p.StartDate.ToString("MMM d") - @p.EndDate.ToString("MMM d, yyyy")</td>
                        <td><span class="badge-difficulty status-inprogress">@(p.StudySessions?.Count ?? 0)</span></td>
                        <td>@p.CreatedAt.ToString("MMM d, yyyy")</td>
                        <td style="text-align:right; white-space:nowrap;">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn-outline-soft" title="View" style="padding:6px 10px; font-size:12px;">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn-outline-soft" title="Delete" style="padding:6px 10px; font-size:12px;">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align:center; color:var(--text-muted); padding:28px;">
                        No plans yet. <a asp-action="Create" style="color:var(--primary); font-weight:600;">Create your first plan</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
