@model SmartStudyPlanner.Domain.Entities.User
@{
    ViewData["Title"] = "Settings";
    var tab = (ViewBag.Tab as string ?? "profile").ToLower();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Manage your account and preferences.</p>
    </div>
</div>

<div class="settings-layout">
    <div class="settings-nav">
        <a class="settings-nav-item @(tab == "profile" ? "active" : "")" asp-action="Index" asp-route-tab="profile">
            <i class="fas fa-user"></i> Profile
        </a>
        <a class="settings-nav-item @(tab == "account" ? "active" : "")" asp-action="Index" asp-route-tab="account">
            <i class="fas fa-shield-alt"></i> Account
        </a>
        <a class="settings-nav-item @(tab == "notifications" ? "active" : "")" asp-action="Index" asp-route-tab="notifications">
            <i class="fas fa-bell"></i> Notifications
        </a>
        <a class="settings-nav-item @(tab == "appearance" ? "active" : "")" asp-action="Index" asp-route-tab="appearance">
            <i class="fas fa-palette"></i> Appearance
        </a>
        <a class="settings-nav-item @(tab == "privacy" ? "active" : "")" asp-action="Index" asp-route-tab="privacy">
            <i class="fas fa-lock"></i> Privacy
        </a>
    </div>

    <div class="settings-panel card">
        @if (TempData["Success"] != null)
        {
            <div style="background:var(--easy-bg); color:var(--easy-text); padding:10px 16px; border-radius:10px; margin-bottom:18px; font-size:14px;">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:16px;"></div>

        @if (tab == "profile")
        {
            <h2 style="font-size:18px; font-weight:700; margin-bottom:4px;">Profile Information</h2>
            <p style="color:var(--text-muted); font-size:13px; margin-bottom:24px;">Update your personal information.</p>

            <form asp-controller="Settings" asp-action="Index" method="post" enctype="multipart/form-data">
                <div class="profile-header">
                    <div class="avatar" id="avatarPreview">
                        <span id="avatarInitial">@(Model?.Name?.Substring(0, 1).ToUpper() ?? "?")</span>
                        @if (Model?.ProfilePicture != null && Model.ProfilePicture.Length > 0)
                        {
                            <img src="@Url.Action("Photo", "Settings")" alt="Profile" id="avatarImg" onerror="this.remove()" />
                        }
                    </div>
                    <input type="file" id="photoInput" name="photo" accept="image/*" style="display:none;" />
                    <button type="button" class="btn-outline-soft" style="padding:8px 14px; font-size:13px;" onclick="document.getElementById('photoInput').click();">
                        <i class="fas fa-camera"></i> Change Photo
                    </button>
                </div>

                <div class="form-group">
                    <label>Full Name</label>
                    <input name="name" type="text" value="@Model?.Name" placeholder="Your full name" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input name="email" type="email" value="@Model?.Email" placeholder="you@example.com" />
                </div>

                <div class="form-group">
                    <label>Academic Year</label>
                    <select name="academicLevel">
                        <option value="">Select your year</option>
                        @foreach (var year in new[] { "1st Year", "2nd Year", "3rd Year", "4th Year", "Graduate" })
                        {
                            <option value="@year" selected="@(Model?.AcademicLevel == year)">@year</option>
                        }
                    </select>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">Save Changes</button>
                </div>
            </form>
        }
        else if (tab == "account")
        {
            <h2 style="font-size:18px; font-weight:700; margin-bottom:4px;">Account</h2>
            <p style="color:var(--text-muted); font-size:13px; margin-bottom:24px;">Email and password for this account: <strong style="color:var(--text-dark);">@Model?.Email</strong></p>

            <h3 style="font-size:15px; font-weight:700; margin-bottom:14px;">Change Password</h3>
            <form asp-action="ChangePassword" method="post">
                <div class="form-group">
                    <label for="currentPassword">Current Password</label>
                    <input type="password" name="currentPassword" id="currentPassword" placeholder="Enter current password" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        <input type="password" name="newPassword" id="newPassword" placeholder="At least 6 characters" />
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Confirm New Password</label>
                        <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Re-enter new password" />
                    </div>
                </div>
                <div class="form-actions" style="margin-top:8px;">
                    <button type="submit" class="btn-primary">Update Password</button>
                </div>
            </form>

            <div class="danger-zone">
                <h3>Danger Zone</h3>
                <p>Deleting your account removes all subjects, tasks, sessions, plans and availability permanently.</p>
                <form asp-action="DeleteAccount" method="post" onsubmit="return confirm('Are you sure? This cannot be undone.');">
                    <div class="form-group">
                        <label for="confirmEmail">Type your email to confirm</label>
                        <input type="email" name="confirmEmail" id="confirmEmail" placeholder="@Model?.Email" />
                    </div>
                    <button type="submit" class="btn-danger">Delete Account</button>
                </form>
            </div>
        }
        else if (tab == "notifications")
        {
            <h2 style="font-size:18px; font-weight:700; margin-bottom:4px;">Notifications</h2>
            <p style="color:var(--text-muted); font-size:13px; margin-bottom:24px;">Choose what you want to be notified about.</p>

            <form asp-action="UpdateNotifications" method="post">
                <label class="pref-row">
                    <span class="pref-text"><strong>Email Notifications</strong><span>Receive important updates by email.</span></span>
                    <span class="switch"><input type="checkbox" name="emailNotifications" value="true" @(Model?.EmailNotifications == true ? "checked" : "") /><span class="slider"></span></span>
                </label>
                <label class="pref-row">
                    <span class="pref-text"><strong>Study Reminders</strong><span>Remind me about today's sessions.</span></span>
                    <span class="switch"><input type="checkbox" name="studyReminders" value="true" @(Model?.StudyReminders == true ? "checked" : "") /><span class="slider"></span></span>
                </label>
                <label class="pref-row">
                    <span class="pref-text"><strong>Exam Alerts</strong><span>Alert me when an exam is getting close.</span></span>
                    <span class="switch"><input type="checkbox" name="examAlerts" value="true" @(Model?.ExamAlerts == true ? "checked" : "") /><span class="slider"></span></span>
                </label>
                <div class="form-actions">
                    <button type="submit" class="btn-primary">Save Preferences</button>
                </div>
            </form>
        }
        else if (tab == "appearance")
        {
            <h2 style="font-size:18px; font-weight:700; margin-bottom:4px;">Appearance</h2>
            <p style="color:var(--text-muted); font-size:13px; margin-bottom:24px;">Customize how the app looks for you.</p>

            <form asp-action="UpdateAppearance" method="post" id="appearanceForm">
                <div class="form-group">
                    <label>Theme</label>
                    <div class="theme-pick">
                        <label class="theme-card @(Model?.Theme != "dark" ? "selected" : "")">
                            <input type="radio" name="theme" value="light" @(Model?.Theme != "dark" ? "checked" : "") />
                            <span class="theme-preview theme-light"><span>Ag</span></span>
                            <span>Light</span>
                        </label>
                        <label class="theme-card @(Model?.Theme == "dark" ? "selected" : "")">
                            <input type="radio" name="theme" value="dark" @(Model?.Theme == "dark" ? "checked" : "") />
                            <span class="theme-preview theme-dark"><span>Ag</span></span>
                            <span>Dark</span>
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label for="language">Language</label>
                    <select name="language" id="language">
                        <option value="en">English</option>
                        <option value="ar">العربية</option>
                    </select>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-primary">Save Preferences</button>
                </div>
            </form>
        }
        else if (tab == "privacy")
        {
            <h2 style="font-size:18px; font-weight:700; margin-bottom:4px;">Privacy</h2>
            <p style="color:var(--text-muted); font-size:13px; margin-bottom:24px;">Control who can see your information.</p>

            <form asp-action="UpdatePrivacy" method="post">
                <label class="pref-row">
                    <span class="pref-text"><strong>Public Profile</strong><span>Allow others to see your profile.</span></span>
                    <span class="switch"><input type="checkbox" name="profilePublic" value="true" @(Model?.ProfilePublic == true ? "checked" : "") /><span class="slider"></span></span>
                </label>
                <label class="pref-row">
                    <span class="pref-text"><strong>Show My Email</strong><span>Display your email on your public profile.</span></span>
                    <span class="switch"><input type="checkbox" name="showEmail" value="true" @(Model?.ShowEmail == true ? "checked" : "") /><span class="slider"></span></span>
                </label>
                <div class="form-actions">
                    <button type="submit" class="btn-primary">Save Preferences</button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('photoInput')?.addEventListener('change', function (e) {
            var file = e.target.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function (ev) {
                var container = document.getElementById('avatarPreview');
                var initial = container.textContent.trim().charAt(0) || '?';
                container.innerHTML = '<span id="avatarInitial">' + initial + '</span>'
                    + '<img src="' + ev.target.result + '" alt="Profile" id="avatarImg" />';
            };
            reader.readAsDataURL(file);
        });

        // Instant theme preview on the appearance tab
        document.querySelectorAll('input[name="theme"]').forEach(function (r) {
            r.addEventListener('change', function () {
                var dark = document.querySelector('input[name="theme"]:checked').value === 'dark';
                if (dark) document.documentElement.setAttribute('data-theme', 'dark');
                else document.documentElement.removeAttribute('data-theme');
                try {
                    localStorage.setItem('ssp-theme', dark ? 'dark' : 'light');
                    document.cookie = 'ssp-theme=' + (dark ? 'dark' : 'light') + ';path=/;max-age=31536000';
                } catch (e) { }
                document.querySelectorAll('.theme-card').forEach(function (c) { c.classList.remove('selected'); });
                r.closest('.theme-card').classList.add('selected');
            });
        });

        // Preselect current language
        (function () {
            var m = document.cookie.match(/(?:^|; )ssp-lang=(ar|en)/);
            var sel = document.getElementById('language');
            if (sel && m) sel.value = m[1];
        })();
    </script>
}
