@model SmartStudyPlanner.Domain.Entities.User
@{
    ViewData["Title"] = "Settings";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Settings</h1>
        <p class="page-subtitle">Manage your account and preferences.</p>
    </div>
</div>

<div class="settings-layout">
    <div class="settings-nav">
        <a class="settings-nav-item active">
            <i class="fas fa-user"></i> Profile
        </a>
        <a class="settings-nav-item disabled-link" title="Coming soon">
            <i class="fas fa-shield-alt"></i> Account
        </a>
        <a class="settings-nav-item disabled-link" title="Coming soon">
            <i class="fas fa-bell"></i> Notifications
        </a>
        <a class="settings-nav-item disabled-link" title="Coming soon">
            <i class="fas fa-palette"></i> Appearance
        </a>
        <a class="settings-nav-item disabled-link" title="Coming soon">
            <i class="fas fa-lock"></i> Privacy
        </a>
    </div>

    <div class="settings-panel card">
        <h2 style="font-size:18px; font-weight:700; margin-bottom:4px;">Profile Information</h2>
        <p style="color:var(--text-muted); font-size:13px; margin-bottom:24px;">Update your personal information.</p>

        <form asp-controller="Settings" asp-action="Index" method="post" enctype="multipart/form-data">
            @if (TempData["Success"] != null)
            {
                <div style="background:#dcfce7; color:#16a34a; padding:10px 16px; border-radius:10px; margin-bottom:18px; font-size:14px;">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="profile-header">
                <div class="avatar" id="avatarPreview">
                    <span id="avatarInitial">@(Model?.Name?.Substring(0, 1).ToUpper() ?? "?")</span>
                    @if (Model?.ProfilePicture != null && Model.ProfilePicture.Length > 0)
                    {
                        <img src="@Url.Action("Photo", "Settings")" alt="Profile" id="avatarImg" onerror="this.remove()" />
                    }
                </div>
                <input type="file" id="photoInput" name="photo" accept="image/*" style="display:none;" />
                <button type="button" class="btn-outline-soft" style="padding:8px 14px; font-size:13px;" onclick="document.getElementById('photoInput').click();">
                    <i class="fas fa-camera"></i> Change Photo
                </button>
            </div>

            <div class="form-group">
                <label>Full Name</label>
                <input name="name" type="text" value="@Model?.Name" placeholder="Your full name" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input name="email" type="email" value="@Model?.Email" placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label>Academic Year</label>
                <select name="academicLevel">
                    <option value="">Select your year</option>
                    @foreach (var year in new[] { "1st Year", "2nd Year", "3rd Year", "4th Year", "Graduate" })
                    {
                        <option value="@year" selected="@(Model?.AcademicLevel == year)">@year</option>
                    }
                </select>
            </div>

            <input type="hidden" name="profilePictureUrl" value="@Model?.ProfilePictureUrl" />

            <div class="form-actions">
                <button type="submit" class="btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('photoInput').addEventListener('change', function (e) {
            var file = e.target.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function (ev) {
                var container = document.getElementById('avatarPreview');
                var initial = container.textContent.trim().charAt(0) || '?';
                container.innerHTML = '<span id="avatarInitial">' + initial + '</span>'
                    + '<img src="' + ev.target.result + '" alt="Profile" id="avatarImg" />';
            };
            reader.readAsDataURL(file);
        });
    </script>
}
