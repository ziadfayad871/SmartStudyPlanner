@model SmartStudyPlanner.Domain.Entities.StudySession

@{
    ViewData["Title"] = "Delete Session";
}

<a asp-action="Index" class="back-link">
    <i class="fas fa-arrow-left"></i> Back to Sessions
</a>

<div class="card form-card" style="text-align:center; padding:40px 32px;">
    <div style="width:60px; height:60px; border-radius:50%; background:var(--hard-bg); color:var(--hard-text); display:flex; align-items:center; justify-content:center; font-size:22px; margin:0 auto 18px;">
        <i class="fas fa-trash"></i>
    </div>
    <h1 class="page-title" style="margin-bottom:8px;">Delete Session?</h1>
    <p class="page-subtitle" style="margin-bottom:24px;">
        @Model.Date.ToString("MMM d, yyyy") &cdot; @Model.StartTime.ToString("hh:mm tt") - @Model.EndTime.ToString("hh:mm tt")<br />
        This action cannot be undone.
    </p>

    <form asp-action="Delete" method="post" style="display:flex; gap:12px; justify-content:center;">
        <input type="hidden" name="id" value="@Model.Id" />
        <a asp-action="Index" class="btn-outline-soft">Cancel</a>
        <button type="submit" class="btn-primary" style="background:var(--hard-text);">Delete</button>
    </form>
</div>
