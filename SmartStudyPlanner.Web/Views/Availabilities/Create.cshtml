@model SmartStudyPlanner.Domain.Entities.Availability

@{
    ViewData["Title"] = "Add Availability";
}

<a asp-action="Index" class="back-link">
    <i class="fas fa-arrow-left"></i> Back to Availability
</a>

<div class="card form-card">
    <h1 class="page-title" style="margin-bottom:24px;">Add Availability</h1>

    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="DayOfWeek">Day <span class="required">*</span></label>
            <select asp-for="DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()"></select>
            <span asp-validation-for="DayOfWeek" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="AvailableFrom">Available From <span class="required">*</span></label>
                <input asp-for="AvailableFrom" type="time" />
                <span asp-validation-for="AvailableFrom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AvailableTo">Available To <span class="required">*</span></label>
                <input asp-for="AvailableTo" type="time" />
                <span asp-validation-for="AvailableTo" class="text-danger"></span>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-outline-soft">Cancel</a>
            <button type="submit" class="btn-primary">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
