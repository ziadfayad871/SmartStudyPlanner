<!DOCTYPE html>
@{
    var _lang = Context.Request.Cookies["ssp-lang"];
    var _isAr = _lang == "ar";
}
<html lang="@(_isAr ? "ar" : "en")" dir="@(_isAr ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Study Planner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                var m = document.cookie.match(/(?:^|; )ssp-theme=(light|dark)/);
                var t = m ? m[1] : localStorage.getItem('ssp-theme');
                if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) { }
        })();
    </script>
</head>
<body>
    <div class="app-layout">
        <aside class="sidebar">
            <button type="button" id="sidebarClose" class="sidebar-close" title="Close">
                <i class="fas fa-times"></i>
            </button>
            <div class="sidebar-brand">
                <div class="brand-icon"><i class="fas fa-book-open"></i></div>
                <div class="brand-text">
                    <span>Smart Study</span>
                    <span>Planner</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-th-large"></i> Dashboard
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subjects" ? "active" : "")"
                   asp-controller="Subjects" asp-action="Index">
                    <i class="fas fa-book"></i> My Subjects
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StudyPlans" ? "active" : "")"
                   asp-controller="StudyPlans" asp-action="Index">
                    <i class="fas fa-calendar-check"></i> Study Plan
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StudySessions" ? "active" : "")"
                   asp-controller="StudySessions" asp-action="Index">
                    <i class="fas fa-clock"></i> Sessions
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Availabilities" ? "active" : "")"
                   asp-controller="Availabilities" asp-action="Index">
                    <i class="fas fa-calendar-day"></i> Availability
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Calendar" ? "active" : "")"
                   asp-controller="Calendar" asp-action="Index">
                    <i class="fas fa-calendar"></i> Calendar
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tasks" ? "active" : "")"
                   asp-controller="Tasks" asp-action="Index">
                    <i class="fas fa-tasks"></i> Tasks
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Statistics" ? "active" : "")"
                   asp-controller="Statistics" asp-action="Index">
                    <i class="fas fa-chart-bar"></i> Statistics
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")"
                   asp-controller="Settings" asp-action="Index">
                    <i class="fas fa-cog"></i> Settings
                </a>
            </nav>

            <div class="sidebar-footer">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div style="width:100%;">
                        <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                            <div class="avatar" style="width:34px; height:34px; font-size:14px; flex-shrink:0;">
                                <span>@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "?")</span>
                                <img src="@Url.Action("Photo", "Settings")" alt="" onerror="this.remove()" />
                            </div>
                            <div style="flex:1; min-width:0;">
                                <div style="color:#fff; font-weight:600; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                    @User.Identity.Name
                                </div>
                            </div>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                            <button type="submit" style="background:none; border:none; color:var(--sidebar-text); font-size:12.5px; cursor:pointer; padding:0; display:flex; align-items:center; gap:8px;">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <i class="fas fa-check-circle"></i>
                    <p>Small steps,<br />every day<br />lead to big results.</p>
                }
            </div>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <main class="main-content">
            <header class="topbar">
                <button type="button" id="sidebarToggle" class="icon-btn" title="Toggle sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="topbar-actions">
                    <button type="button" id="langToggle" class="icon-btn lang-btn" title="@(_isAr ? "English" : "عربي")">
                        @(_isAr ? "EN" : "عربي")
                    </button>
                    <button type="button" id="themeToggle" class="icon-btn" title="Toggle dark mode">
                        <i class="fas fa-moon"></i>
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="profile-menu" id="profileMenu">
                            <button type="button" class="profile-btn" id="profileBtn">
                                <span class="mini-avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "?")<img src="@Url.Action("Photo", "Settings")" alt="" onerror="this.remove()" /></span>
                                <span class="profile-name">@User.Identity.Name</span>
                                <i class="fas fa-chevron-down chevron"></i>
                            </button>
                            <div class="profile-dropdown">
                                <div class="pd-header">
                                    <div class="pd-name">@User.Identity.Name</div>
                                </div>
                                <a class="profile-item" asp-controller="Settings" asp-action="Index">
                                    <i class="fas fa-user-cog"></i> Profile Settings
                                </a>
                                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                                    <button type="submit" class="profile-item">
                                        <i class="fas fa-sign-out-alt"></i> Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </header>

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script>
        (function () {
            var langBtn = document.getElementById('langToggle');
            if (langBtn) langBtn.addEventListener('click', function () {
                var isAr = document.documentElement.lang === 'ar';
                try { document.cookie = 'ssp-lang=' + (isAr ? 'en' : 'ar') + ';path=/;max-age=31536000'; } catch (e) { }
                location.reload();
            });
        })();
    </script>
    <script>
        (function () {
            var layout = document.querySelector('.app-layout');

            try {
                if (localStorage.getItem('ssp-sidebar') === 'collapsed') layout.classList.add('sidebar-collapsed');
            } catch (e) { }

            var toggle = document.getElementById('sidebarToggle');
            if (toggle) toggle.addEventListener('click', function () {
                if (window.innerWidth < 993) {
                    layout.classList.toggle('sidebar-open');
                } else {
                    var collapsed = layout.classList.toggle('sidebar-collapsed');
                    try { localStorage.setItem('ssp-sidebar', collapsed ? 'collapsed' : ''); } catch (e) { }
                }
            });

            function closeSidebar() { layout.classList.remove('sidebar-open'); }
            var closeBtn = document.getElementById('sidebarClose');
            if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
            var backdrop = document.getElementById('sidebarBackdrop');
            if (backdrop) backdrop.addEventListener('click', closeSidebar);
            document.querySelectorAll('.sidebar-nav .nav-link').forEach(function (a) {
                a.addEventListener('click', function () {
                    if (window.innerWidth < 993) closeSidebar();
                });
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            var themeBtn = document.getElementById('themeToggle');
            function paintThemeIcon() {
                var dark = document.documentElement.getAttribute('data-theme') === 'dark';
                var icon = themeBtn.querySelector('i');
                if (icon) icon.className = dark ? 'fas fa-sun' : 'fas fa-moon';
            }
            if (themeBtn) {
                paintThemeIcon();
                themeBtn.addEventListener('click', function () {
                    var dark = document.documentElement.getAttribute('data-theme') === 'dark';
                    if (dark) document.documentElement.removeAttribute('data-theme');
                    else document.documentElement.setAttribute('data-theme', 'dark');
                    try {
                        localStorage.setItem('ssp-theme', dark ? 'light' : 'dark');
                        document.cookie = 'ssp-theme=' + (dark ? 'light' : 'dark') + ';path=/;max-age=31536000';
                    } catch (e) { }
                    paintThemeIcon();
                });
            }

            var menu = document.getElementById('profileMenu');
            var menuBtn = document.getElementById('profileBtn');
            if (menu && menuBtn) {
                menuBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    menu.classList.toggle('open');
                });
                document.addEventListener('click', function (e) {
                    if (!menu.contains(e.target)) menu.classList.remove('open');
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
